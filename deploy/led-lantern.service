[Unit]
Description=LED Lantern display
Wants=network-online.target
After=network-online.target mediamtx.service

[Service]
EnvironmentFile=/etc/led-lantern/led-lantern.env
ExecStart=/usr/local/bin/led-lantern
StateDirectory=led-lantern
TemporaryFileSystem=/var/cache/led-lantern:size=1536M
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
